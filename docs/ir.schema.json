{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/repoctx.ir.v1alpha4.schema.json",
  "title": "repoctx IR v1alpha4",
  "type": "object",
  "required": [
    "v",
    "f",
    "inputs"
  ],
  "properties": {
    "v": {
      "const": "repoctx.ir/v1alpha4"
    },
    "r": {
      "type": "integer",
      "minimum": 0
    },
    "q": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "f": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "s": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },
    "e": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "d": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "g": {
      "$ref": "#/$defs/symbolGraph"
    },
    "inputs": {
      "$ref": "#/$defs/inputManifest"
    },
    "entities": {
      "$ref": "#/$defs/entityModel"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "span": {
      "type": "object",
      "required": [
        "a",
        "b",
        "c",
        "d"
      ],
      "properties": {
        "a": {
          "type": "integer",
          "minimum": 0
        },
        "b": {
          "type": "integer",
          "minimum": 0
        },
        "c": {
          "type": "integer",
          "minimum": 0
        },
        "d": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "k",
        "x"
      ],
      "properties": {
        "k": {
          "type": "integer",
          "minimum": 1
        },
        "t": {
          "type": "integer",
          "minimum": 1
        },
        "x": {
          "$ref": "#/$defs/span"
        },
        "c": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": [
        "p",
        "l",
        "h"
      ],
      "properties": {
        "p": {
          "type": "integer",
          "minimum": 1
        },
        "l": {
          "enum": [
            1,
            2,
            3,
            4,
            5,
            6,
            7,
            8
          ]
        },
        "h": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "u": {
          "type": "integer",
          "minimum": 1
        },
        "n": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "a": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "symbol": {
      "type": "object",
      "required": [
        "i",
        "n",
        "k",
        "f",
        "a"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "f": {
          "type": "integer",
          "minimum": 0
        },
        "a": {
          "type": "integer",
          "minimum": 0
        },
        "p": {
          "type": "integer",
          "minimum": 1
        },
        "i": {
          "type": "integer",
          "minimum": 1
        },
        "r": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "ref": {
      "type": "object",
      "required": [
        "f",
        "n"
      ],
      "properties": {
        "f": {
          "type": "integer",
          "minimum": 0
        },
        "n": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "k",
        "f"
      ],
      "properties": {
        "k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "f": {
          "$ref": "#/$defs/ref"
        },
        "s": {
          "type": "integer",
          "minimum": 1
        },
        "t": {
          "type": "integer",
          "minimum": 1
        },
        "o": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "s",
        "m"
      ],
      "properties": {
        "s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "f": {
          "type": "integer",
          "minimum": 1
        },
        "m": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "graphExternal": {
      "type": "object",
      "required": [
        "n",
        "k"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "additionalProperties": false
    },
    "csr": {
      "type": "object",
      "required": [
        "o"
      ],
      "properties": {
        "o": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "t": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "k": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "Packed uint8 EdgeKind vector; one byte per CSR arc."
        },
        "w": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "additionalProperties": false
    },
    "symbolGraph": {
      "type": "object",
      "required": [
        "o",
        "i"
      ],
      "properties": {
        "x": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/graphExternal"
          }
        },
        "o": {
          "$ref": "#/$defs/csr"
        },
        "i": {
          "$ref": "#/$defs/csr"
        }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "present",
            "absent",
            "unavailable"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        }
      },
      "required": [
        "path",
        "state"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "present"
              }
            }
          },
          "then": {
            "required": [
              "sha256"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sha256"
                  ]
                },
                {
                  "required": [
                    "bytes"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "compilationProfile": {
      "type": "object",
      "properties": {
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "frontends": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "ignore_dirs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "max_read_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "max_entries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "compiler",
        "frontends",
        "build",
        "allow",
        "deny",
        "ignore_dirs",
        "max_file_bytes",
        "max_read_bytes",
        "max_entries"
      ],
      "additionalProperties": false
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "start_byte": {"type": "integer", "minimum": 0},
        "end_byte": {"type": "integer", "minimum": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "start_byte_column": {"type": "integer", "minimum": 0},
        "end_byte_column": {"type": "integer", "minimum": 0}
      },
      "required": ["path", "sha256", "start_byte", "end_byte", "start_line", "end_line", "start_byte_column", "end_byte_column"]
    },
    "entityScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["file", "subtree"]},
        "path": {"type": "string"}
      },
      "required": ["kind", "path"]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}:[a-z][a-z0-9._-]{0,127}$"},
        "kind": {"enum": ["document", "component", "decision", "contract", "requirement", "verification_obligation", "owner"]},
        "owners": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string"}},
        "scopes": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/entityScope"}},
        "lifecycle": {"enum": ["draft", "active", "deprecated", "superseded", "retired"]},
        "supersedes": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string"}},
        "sensitivity": {"enum": ["public", "internal", "restricted"]},
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"inputs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string"}}},
          "required": ["inputs"]
        },
        "declaration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"status": {"const": "declared"}, "source": {"$ref": "#/$defs/sourceSpan"}},
          "required": ["status", "source"]
        }
      },
      "required": ["id", "kind", "owners", "scopes", "lifecycle", "supersedes", "sensitivity", "freshness", "declaration"]
    },
    "entityModel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {"const": "repoctx.entities/v1alpha1"},
        "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "entities": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/entity"}}
      },
      "required": ["version", "namespace", "entities"]
    },
    "inputManifest": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "#/$defs/compilationProfile"
        },
        "sources": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/input"
              },
              {
                "properties": {
                  "state": {
                    "const": "present"
                  }
                }
              }
            ]
          }
        },
        "go_mod": {
          "allOf": [
            {
              "$ref": "#/$defs/input"
            },
            {
              "properties": {
                "path": {
                  "const": "go.mod"
                }
              }
            }
          ]
        }
      },
      "required": [
        "profile",
        "sources",
        "go_mod"
      ],
      "additionalProperties": false
    }
  }
}
