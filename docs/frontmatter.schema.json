{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tdeshazo/repoctx/docs/frontmatter.schema.json",
  "title": "repoctx typed document frontmatter v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"const": "repoctx.frontmatter/v1alpha1"},
    "entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/entity"}
    }
  },
  "required": ["version", "entities"],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "id_list": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"kind": {"enum": ["file", "subtree"]}, "path": {"$ref": "#/$defs/path"}},
      "required": ["kind", "path"]
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"inputs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}},
      "required": ["inputs"]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["document", "component", "decision", "contract", "requirement", "verification_obligation", "owner"]},
        "owners": {"$ref": "#/$defs/id_list"},
        "scopes": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/scope"}},
        "lifecycle": {"enum": ["draft", "active", "deprecated", "superseded", "retired"]},
        "supersedes": {"$ref": "#/$defs/id_list"},
        "sensitivity": {"enum": ["public", "internal", "restricted"]},
        "freshness": {"$ref": "#/$defs/freshness"}
      },
      "required": ["id", "kind", "owners", "scopes", "lifecycle", "supersedes", "sensitivity", "freshness"]
    }
  },
  "$comment": "Applied to YAML between a Markdown file's opening and closing --- lines. Runtime also rejects aliases, anchors, explicit tags, duplicate fields, unsafe paths, unresolved owner/supersession references, and bounded-resource violations."
}
