{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/repoctx.context.v1alpha1.schema.json",
  "title": "repoctx agent context v1alpha1",
  "type": "object",
  "properties": {
    "version": {
      "const": "repoctx.context/v1alpha1"
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "query": {
      "type": "string"
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trust": {
      "$ref": "#/$defs/trust"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "selection": {
      "$ref": "#/$defs/selection"
    },
    "symbols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "omissions": {
      "$ref": "#/$defs/omissions"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "version",
    "snapshot",
    "seeds",
    "trust",
    "capabilities",
    "selection",
    "symbols",
    "evidence",
    "omissions",
    "warnings"
  ],
  "additionalProperties": false,
  "$defs": {
    "span": {
      "type": "object",
      "properties": {
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "start_byte_column": {
          "type": "integer",
          "minimum": 0
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_byte_column": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "start_line",
        "start_byte_column",
        "end_line",
        "end_byte_column"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "ir_version": {
          "const": "repoctx.ir/v1alpha3"
        },
        "verification": {
          "const": "sha256_all_permitted_indexed_files"
        },
        "verified_files": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "ir_version",
        "verification",
        "verified_files"
      ],
      "additionalProperties": false
    },
    "trust": {
      "type": "object",
      "properties": {
        "role": {
          "const": "untrusted_repository_data"
        },
        "handling": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "handling"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "available": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unavailable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "call_resolution": {
          "type": "string"
        },
        "verification": {
          "type": "string"
        }
      },
      "required": [
        "available",
        "unavailable",
        "call_resolution",
        "verification"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "strategy": {
          "const": "lexical_seeds_then_bounded_graph"
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "direction": {
          "enum": [
            "in",
            "out",
            "both"
          ]
        },
        "relations": {
          "type": "array",
          "items": {
            "enum": [
              "calls",
              "defines",
              "imports"
            ]
          }
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_symbols": {
          "type": "integer",
          "minimum": 0
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "max_relations": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "strategy",
        "depth",
        "direction",
        "relations",
        "max_bytes",
        "max_symbols",
        "max_candidates",
        "max_relations"
      ],
      "additionalProperties": false
    },
    "reason": {
      "type": "object",
      "properties": {
        "strategy": {
          "enum": [
            "explicit_symbol",
            "lexical_seed",
            "graph_neighbor"
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "via": {
          "type": "string"
        },
        "relation": {
          "enum": [
            "calls",
            "defines",
            "imports"
          ]
        },
        "direction": {
          "enum": [
            "in",
            "out"
          ]
        }
      },
      "required": [
        "strategy",
        "depth",
        "score"
      ],
      "additionalProperties": false
    },
    "symbol": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "module",
            "type",
            "function",
            "method",
            "variable",
            "constant"
          ]
        },
        "language": {
          "enum": [
            "go",
            "python",
            "html",
            "css",
            "javascript",
            "typescript",
            "tsx"
          ]
        },
        "file": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "definition": {
          "$ref": "#/$defs/span"
        },
        "evidence": {
          "type": "string"
        },
        "completeness": {
          "enum": [
            "full_definition",
            "declaration_excerpt"
          ]
        },
        "reason": {
          "$ref": "#/$defs/reason"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "language",
        "file",
        "definition",
        "evidence",
        "completeness",
        "reason"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^e:[0-9a-f]{24}$"
        },
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "enum": [
            "source",
            "imports"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "file",
        "sha256",
        "span",
        "start_byte",
        "end_byte",
        "role",
        "text"
      ],
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "file",
        "span",
        "sha256"
      ],
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "defines",
            "calls",
            "imports",
            "references"
          ]
        },
        "resolution": {
          "enum": [
            "syntactic",
            "name_heuristic",
            "unresolved"
          ]
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        }
      },
      "required": [
        "from",
        "to",
        "kind",
        "resolution",
        "occurrences"
      ],
      "additionalProperties": false
    },
    "omissions": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "integer",
          "minimum": 0
        },
        "budget": {
          "type": "integer",
          "minimum": 0
        },
        "symbol_limit": {
          "type": "integer",
          "minimum": 0
        },
        "excerpts": {
          "type": "integer",
          "minimum": 0
        },
        "relations": {
          "type": "integer",
          "minimum": 0
        },
        "imports": {
          "type": "integer",
          "minimum": 0
        },
        "traversal_limited": {
          "type": "boolean"
        }
      },
      "required": [
        "candidates",
        "budget",
        "symbol_limit",
        "excerpts",
        "relations",
        "imports",
        "traversal_limited"
      ],
      "additionalProperties": false
    }
  }
}
